{
  "name": "deadlineai",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @deadlineai/db prisma generate",
    "db:migrate": "pnpm --filter @deadlineai/db prisma migrate dev",
    "db:studio": "pnpm --filter @deadlineai/db prisma studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}