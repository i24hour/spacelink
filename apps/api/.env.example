DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deadlineai"
UPSTASH_REDIS_URL="rediss://default:password@host:6379"

# Auth (DeadlineAI JWT + optional Clerk fallback)
JWT_SECRET="change-this-to-a-long-random-string-at-least-32-chars"
TELEGRAM_LINK_SECRET=""
TELEGRAM_WEBHOOK_SECRET=""
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Google OAuth (for extension sign-in)
GOOGLE_CLIENT_IDS="your-google-client-id.apps.googleusercontent.com"

FRONTEND_URL="http://localhost:3000"
PORT=4000

LITELLM_PROXY_URL="http://localhost:4001/v1"
LITELLM_API_KEY="sk-..."
LITELLM_MODEL="gpt-4o"

FIRECRAWL_API_KEY="fc-..."

# Email (Google SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-google-app-password"
EMAIL_FROM="DeadlineAI <your-email@gmail.com>"

# Telegram Bot
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
TELEGRAM_BOT_NAME="DeadlineAIBot"
TELEGRAM_WEBHOOK_URL="https://your-api.com/api/webhooks/telegram"
# Optional: max bytes for Telegram image vision (default 10485760 = 10MB)
MAX_TELEGRAM_IMAGE_BYTES="10485760"

# WhatsApp (paused for now)
WHATSAPP_PHONE_NUMBER_ID="..."
WHATSAPP_ACCESS_TOKEN="..."

CRON_INTERVAL_MS=60000
