generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String   @unique
  displayName       String?  @map("display_name")
  bio               String?
  profileVisibility String   @default("private") @map("profile_visibility")
  telegramId        String?  @map("telegram_id")
  whatsappNumber    String?  @map("whatsapp_number")
  preferredChannels String[] @default(["email"]) @map("preferred_channels")
  timezone            String   @default("UTC")
  timezoneConfigured  Boolean  @default(false) @map("timezone_configured")
  dailyReminderHour   Int      @default(9) @map("daily_reminder_hour")
  plan                String   @default("free")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  savedLinks SavedLink[]
  followers  Follow[] @relation("IncomingFollows")
  following  Follow[] @relation("OutgoingFollows")
  mobileDevices MobileDevice[]
  mobilePairingCodes MobilePairingCode[]
  monitoringSessions MonitoringSession[]

  @@map("app_users")
}

model MobileDevice {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String    @default("Android phone")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitoringSessions MonitoringSession[]
  screenChecks ScreenCheck[]

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("mobile_devices")
}

model MobilePairingCode {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("mobile_pairing_codes")
}

model MonitoringSession {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  deviceId      String    @map("device_id")
  goal          String
  status        String    @default("active")
  intervalMins  Int       @default(60) @map("interval_mins")
  startedAt     DateTime  @default(now()) @map("started_at")
  pausedAt      DateTime? @map("paused_at")
  stoppedAt     DateTime? @map("stopped_at")
  lastCheckAt   DateTime? @map("last_check_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  device MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  screenChecks ScreenCheck[]

  @@index([userId, status])
  @@index([deviceId, status])
  @@map("monitoring_sessions")
}

model ScreenCheck {
  id                String    @id @default(cuid())
  sessionId         String    @map("session_id")
  deviceId          String    @map("device_id")
  capturedAt        DateTime  @map("captured_at")
  analyzedAt        DateTime  @default(now()) @map("analyzed_at")
  classification    String
  confidence        Float?
  observedActivity  String?   @map("observed_activity")
  reason            String?
  suggestion        String?
  sensitiveContent  Boolean   @default(false) @map("sensitive_content")
  telegramSentAt    DateTime? @map("telegram_sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  session MonitoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device MobileDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([sessionId, capturedAt])
  @@index([deviceId, capturedAt])
  @@map("screen_checks")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("OutgoingFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("IncomingFollows", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model SavedLink {
  id                         String    @id @default(cuid())
  userId                     String    @map("user_id")
  url                        String
  title                      String
  rawContent                 String?   @map("raw_content")
  extractedDeadline          DateTime? @map("extracted_deadline")
  timezone                   String?
  category                   String?
  urgencyScore               Int?      @map("urgency_score")
  confidenceScore            Float?    @map("confidence_score")
  status                     String    @default("active")
  visibility                 String    @default("private")
  rollingApplication         Boolean   @default(false) @map("rolling_application")
  estimatedCompletionMinutes Int?      @map("estimated_completion_minutes")
  metadata                   Json?     @default("{}")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId])
  @@index([status])
  @@index([extractedDeadline])
  @@index([visibility])
  @@map("saved_links")
}

model Reminder {
  id           String   @id @default(cuid())
  savedLinkId  String   @map("saved_link_id")
  reminderTime DateTime @map("reminder_time")
  reminderType String   @map("reminder_type")
  channel      String
  sentStatus   String   @default("pending") @map("sent_status")
  aiMessage    String?  @map("ai_message")
  createdAt    DateTime @default(now()) @map("created_at")

  savedLink        SavedLink          @relation(fields: [savedLinkId], references: [id], onDelete: Cascade)
  notificationLogs NotificationLog[]

  @@index([savedLinkId])
  @@index([sentStatus])
  @@index([reminderTime])
  @@map("reminders")
}

model NotificationLog {
  id             String   @id @default(cuid())
  reminderId     String   @map("reminder_id")
  deliveryStatus String   @map("delivery_status")
  responseData   Json?    @map("response_data")
  sentAt         DateTime @default(now()) @map("sent_at")

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@index([reminderId])
  @@map("notification_logs")
}
